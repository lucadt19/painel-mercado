# Copie este arquivo para .env.local e preencha. O .env.local não vai para o git.

# Token da brapi.dev (painel da brapi > API Keys). Usado só no servidor.
BRAPI_TOKEN=

# Intervalo de atualização das cotações, em segundos. Use o atraso do seu plano:
# Gratuito = 1800 (30 min) · Startup = 900 (15 min) · Pro = 300 (5 min)
QUOTES_REFRESH_SECONDS=1800

# Quantos tickers a brapi aceita por chamada no seu plano:
# Gratuito = 1 · Startup = 10 · Pro = 20
BRAPI_MAX_TICKERS_PER_REQUEST=1

# Cota mensal de requisições do plano (para o aviso de 80% no log):
# Gratuito = 15000 · Startup = 150000 · Pro = 500000
BRAPI_MONTHLY_QUOTA=15000
